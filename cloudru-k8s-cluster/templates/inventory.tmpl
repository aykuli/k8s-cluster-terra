all:
  children:
    k8s_cluster:
      children:
        master:
          hosts:
            master1:
              ansible_host: {{ .master_ip }}
              ansible_user: aynur
              ansible_become: true
        workers:
          hosts:
          {{- range $w := .workers }}
            {{ $w.hostname }}:
              ansible_host: {{ $w.ip }}
              ansible_user: aynur
              ansible_become: true
          {{- end }}
